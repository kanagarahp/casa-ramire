# Salin nilai ini ke Vercel Environment Variables (Production).
# Jangan commit file .env yang berisi nilai asli.

# Database katalog, state, dan payment intent (Vercel Postgres/Supabase).
POSTGRES_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Kunci untuk sinkronisasi state, publikasi katalog, dan pembuatan link DOKU.
# Nilai ini juga dimasukkan admin ke Pengaturan aplikasi.
CATALOG_ADMIN_KEY=""

# DOKU Checkout
DOKU_MODE="production"
DOKU_CLIENT_ID=""
DOKU_SECRET_KEY=""
APP_URL="https://www.casaramire.com"
DOKU_PAYMENT_DUE_MINUTES="10080"

# Opsional: batasi channel yang aktif di akun DOKU.
# DOKU_PAYMENT_CHANNELS="QRIS,VIRTUAL_ACCOUNT_BCA,EMONEY_DANA"
